{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "PPL",
  "scopeName": "source.ppl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#backtick_identifiers" },
    { "include": "#functions" },
    { "include": "#keywords" },
    { "include": "#pipe_operator" },
    { "include": "#field_references" },
    { "include": "#operators" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ppl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ppl",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ppl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ppl",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.ppl",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ppl",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "backtick_identifiers": {
      "name": "variable.other.quoted.ppl",
      "begin": "`",
      "end": "`"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ppl",
          "match": "(?i)^\\s*(source|search)\\b",
          "captures": {
            "1": { "name": "keyword.control.ppl" }
          }
        },
        {
          "match": "(?i)(?<=\\[)[ \\t]*(source|search)\\b",
          "captures": {
            "1": { "name": "keyword.control.ppl" }
          }
        },
        {
          "match": "(?i)(?<=\\|)[ \\t]*(where|stats|eventstats|streamstats|fields|table|eval|sort|rename|dedup|head|top|rare|grok|patterns|parse|rex|regex|lookup|join|fillnull|flatten|expand|trendline|timechart|bin|spath|replace|reverse)\\b",
          "captures": {
            "1": { "name": "keyword.control.ppl" }
          }
        },
        {
          "name": "keyword.operator.logical.ppl",
          "match": "(?i)\\b(and|or|not|in|like|rlike|between|is\\s+not|is)\\b"
        },
        {
          "name": "keyword.other.ppl",
          "match": "(?i)\\b(by|as|on|replace|append|output|left|right|inner|outer|semi|anti|asc|desc|nulls|first|last|interval|from|else)\\b"
        },
        {
          "name": "variable.parameter.ppl",
          "match": "(?i)\\b(?:field|mode|max_match|offset_field|window|current|global|bucket_nullable|reset_before|reset_after|type|overwrite|max|keepempty|consecutive|span|limit|useother|usenull|nullstr|timefield|aligntime|start|end)\\b(?=\\s*=)"
        }
      ]
    },
    "pipe_operator": {
      "name": "keyword.operator.pipe.ppl",
      "match": "\\|"
    },
    "field_references": {
      "patterns": [
        {
          "name": "variable.other.ppl",
          "match": "(?<![\\w@])@[a-zA-Z_][\\w.]*(?![\\w.])"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.ppl",
          "match": "(?i)\\b(add|subtract|multiply|divide|acos|asin|atan|atan2|conv|cos|cosh|cot|crc32|degrees|e|expm1|mod|modulus|pi|radians|rand|sign|signum|sin|sinh|rint|addtime|curdate|current_date|current_time|curtime|datetime|datediff|dayofmonth|day_of_month|dayofweek|day_of_week|dayofyear|day_of_year|from_days|get_format|hour_of_day|last_day|localtimestamp|localtime|makedate|maketime|microsecond|minute_of_hour|month_of_year|monthname|period_add|period_diff|quarter|sec_to_time|second_of_minute|strftime|str_to_date|subdate|subtime|sysdate|time|time_format|time_to_sec|timediff|to_days|to_seconds|utc_date|utc_time|utc_timestamp|week|weekday|week_of_year|yearweek|tostring|tonumber|sha2|locate|reverse|geoip|json|json_valid|json_object|json_array|json_array_length|json_extract|json_delete|json_set|json_append|json_extend|json_keys|match|match_phrase|match_phrase_prefix|multi_match|simple_query_string|match_bool_prefix|query_string)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.ppl",
          "match": "(?i)\\b(array|array_length|forall|exists|filter|transform|reduce|mvjoin|mvappend|split|mvdedup|mvfind|mvindex|mvmap|mvzip)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.ppl",
          "match": "(?i)\\b(?:perc|p)\\d+(?:\\.\\d+)?(?=\\s*\\()"
        },
        {
          "name": "support.function.ppl",
          "match": "(?i)\\b(count|avg|sum|min|max|dc|distinct_count|distinct_count_approx|first|last|list|values|take|median|earliest|latest|var_pop|var_samp|stddev_pop|stddev_samp|percentile|percentile_approx|str|num|ip|auto|abs|ceil|ceiling|floor|round|sqrt|cbrt|exp|ln|log|log10|log2|pow|power|lower|upper|trim|ltrim|rtrim|concat|concat_ws|length|substr|substring|replace|regexp_replace|regexp_extract|regexp_match|now|current_timestamp|timestampadd|timestampdiff|from_unixtime|unix_timestamp|convert_tz|date_format|date_add|date_sub|adddate|date|dayname|year|month|day|hour|minute|second|if|ifnull|case|coalesce|isnull|isnotnull|ispresent|isblank|isempty|nullif|like|ilike|position|cidrmatch|geoip|span|md5|sha1|sha256|cast|typeof)\\b(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.boost.ppl",
          "match": "\\^"
        },
        {
          "name": "keyword.operator.lambda.ppl",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.ppl",
          "match": "(==|!=|<>|<=|>=|<|>|=)"
        },
        {
          "name": "keyword.operator.arithmetic.ppl",
          "match": "(\\+|\\-|\\*|\\/|%)"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.logarithmic.ppl",
          "match": "\\b\\d+(?:\\.\\d+)?log10\\b"
        },
        {
          "name": "constant.numeric.duration.ppl",
          "match": "\\b\\d+(?:\\.\\d+)?(?:ms|milliseconds?|seconds?|minutes?|hours?|days?|weeks?|months?|quarters?|years?|s|m|h|d|w|M|q|y)\\b"
        },
        {
          "name": "constant.language.boolean.ppl",
          "match": "(?i)\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.ppl",
          "match": "(?i)\\bnull\\b"
        },
        {
          "name": "constant.numeric.ppl",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    }
  }
}
