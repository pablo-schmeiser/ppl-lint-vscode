{
  "name": "ppl-lint-vscode",
  "displayName": "PPL Linter (Piped Processing Language)",
  "version": "0.1.0",
  "description": "Visual Studio Code extension for linting Piped Processing Language (PPL) in standalone files and embedded within YAML, TOML, and JSON configurations.",
  "publisher": "pablo-schmeiser",
  "license": "Apache-2.0",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/pablo-schmeiser/ppl-lint-vscode.git"
  },
  "main": "./dist/extension.js",
  "bin": {
    "ppl-lint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "syntaxes",
    "language-configuration.json"
  ],
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "ppl",
    "opensearch",
    "piped processing language",
    "linter",
    "yaml",
    "toml",
    "json"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:toml",
    "onLanguage:json",
    "onLanguage:jsonc",
    "workspaceContains:**/*.ppl",
    "workspaceContains:**/*.yaml",
    "workspaceContains:**/*.yml",
    "workspaceContains:**/*.toml"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs --production",
    "cli": "node dist/cli.js",
    "prepack": "pnpm build",
    "vscode:prepublish": "pnpm build",
    "watch": "node esbuild.config.mjs --watch",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:conformance": "vitest run --config vitest.conformance.config.mts",
    "test:watch": "vitest",
    "test:coverage": "vitest run test/unit --coverage",
    "test:thorough": "pnpm audit --audit-level high && pnpm compile && pnpm lint && pnpm test && pnpm run test:integration && pnpm build",
    "lint": "eslint src",
    "compile": "tsc -p ./ --noEmit",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "contributes": {
    "languages": [
      {
        "id": "ppl",
        "aliases": [
          "PPL",
          "ppl"
        ],
        "extensions": [
          ".ppl",
          ".pplquery",
          ".query"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ppl",
        "scopeName": "source.ppl",
        "path": "./syntaxes/ppl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pplLinter.lintCurrentFile",
        "title": "PPL: Lint Current File",
        "category": "PPL"
      },
      {
        "command": "pplLinter.toggleEnabled",
        "title": "PPL: Toggle Linting Enabled",
        "category": "PPL"
      },
      {
        "command": "pplLinter.refreshOpenSearchIndexTemplates",
        "title": "PPL: Refresh OpenSearch Index Patterns",
        "category": "PPL"
      },
      {
        "command": "pplLinter.showOpenSearchLogs",
        "title": "PPL: Show OpenSearch Logs",
        "category": "PPL"
      }
    ],
    "configuration": {
      "title": "PPL Linter",
      "properties": {
        "pplLinter.configFile": {
          "type": "string",
          "description": "Shared PPL configuration file, relative to the first workspace folder or an absolute local path. Set empty to disable shared-file loading."
        },
        "pplLinter.enabled": {
          "type": "boolean",
          "description": "Enable or disable PPL linting globally."
        },
        "pplLinter.openSearchVersion": {
          "type": "string",
          "description": "Target OpenSearch version (major.minor or major.minor.patch, minimum 3.5). Newer unverified versions use the 3.5 baseline with a warning."
        },
        "pplLinter.openSearchUrl": {
          "type": "string",
          "description": "OpenSearch domain URL. Do not embed credentials."
        },
        "pplLinter.openSearchUsername": {
          "type": "string",
          "description": "OpenSearch username. Passwords are never read from configuration files."
        },
        "pplLinter.indexTemplateGlob": {
          "type": "string",
          "description": "Glob for local OpenSearch index-template YAML files, relative to the workspace or absolute for external folders. Remote templates are fetched from OpenSearch separately."
        },
        "pplLinter.openSearchTemplateNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional list of OpenSearch index-template names or wildcard patterns to fetch. Empty fetches all templates."
        },
        "pplLinter.openSearchMappingIndexes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Index names, aliases, or * and ? patterns whose live mappings should be fetched from the configured OpenSearch domain, for example mam_*."
        },
        "pplLinter.includedIndexes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional allowlist of PPL source index names, aliases, or patterns using * and ?. Empty includes all sources."
        },
        "pplLinter.standalone": {
          "type": "object",
          "description": "Settings for standalone PPL files.",
          "properties": {
            "fileExtensions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "File extensions treated directly as standalone PPL."
            },
            "languageIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "VSCode language identifiers to lint as PPL."
            }
          }
        },
        "pplLinter.embedded": {
          "type": "array",
          "description": "Rules for extracting and linting PPL queries inside structured documents.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "filePattern",
              "format",
              "keyPatterns"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier for this embedded rule."
              },
              "filePattern": {
                "type": "string",
                "description": "Glob pattern matching host files."
              },
              "format": {
                "type": "string",
                "enum": [
                  "yaml",
                  "toml",
                  "json"
                ],
                "description": "Format parser to use for extracting queries."
              },
              "keyPatterns": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Key paths (dot-delimited, wildcard `*`) containing PPL."
              },
              "heuristicDetection": {
                "type": "boolean",
                "description": "If true, inspects string values matching regex /^\\s*(source|search)\\s*=/i even if keys are not explicitly listed."
              }
            }
          }
        },
        "pplLinter.customCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional user-defined known PPL pipe commands to recognize, preventing PPL003 unknown command errors."
        },
        "pplLinter.customFunctions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional user-defined function names to recognize in expressions, preventing PPL005 unknown function warnings."
        },
        "pplLinter.additionalKeyPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Additional key patterns (dot-delimited, wildcard `*`, or `!pattern` to exclude) to extract PPL queries from structured documents (YAML, TOML, JSON) without replacing default embedded rules."
        },
        "pplLinter.excludeKeyPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Key patterns to exclude from PPL query extraction, removing them from the active pattern list."
        },
        "pplLinter.overrideDefaultKeyPatterns": {
          "type": "boolean",
          "description": "If true, ignores built-in default extractor key patterns and uses only user-specified key patterns."
        },
        "pplLinter.rules": {
          "type": "object",
          "description": "Configurable severity levels for specific linter rules ('error', 'warning', 'info', 'off').",
          "properties": {
            "PPL001": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "off"
              ],
              "description": "PPL001: Syntax Error"
            },
            "PPL002": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "off"
              ],
              "description": "PPL002: Missing Source Stage"
            },
            "PPL003": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "off"
              ],
              "description": "PPL003: Unknown Command"
            },
            "PPL004": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "off"
              ],
              "description": "PPL004: Invalid Arguments"
            },
            "PPL005": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "off"
              ],
              "description": "PPL005: Unknown Function"
            },
            "PPL006": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "off"
              ],
              "description": "PPL006: Late Filter Performance Warning"
            },
            "PPL008": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "off"
              ],
              "description": "PPL008: Validation not implemented for raw-argument stages"
            },
            "PPL009": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "off"
              ],
              "description": "PPL009: Selected OpenSearch version has not been verified"
            },
            "PPL010": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "off"
              ],
              "description": "PPL010: Selected OpenSearch version is invalid or older than 3.5"
            },
            "PPL011": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "off"
              ],
              "default": "error",
              "description": "PPL011: No configured index template matches the source"
            },
            "PPL012": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "off"
              ],
              "default": "error",
              "description": "PPL012: Field is not declared or has no supported PPL type"
            },
            "PPL013": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "off"
              ],
              "default": "error",
              "description": "PPL013: Field has conflicting mapped PPL types"
            },
            "PPL014": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "off"
              ],
              "default": "error",
              "description": "PPL014: Function arguments, casts or operators have incompatible types"
            },
            "PPL015": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "off"
              ],
              "default": "warning",
              "description": "PPL015: Implicit conversion may fail for some values"
            }
          }
        },
        "pplLinter.lintOnType": {
          "type": "boolean",
          "description": "Lint on typing with debouncing. If false, lints only on save."
        },
        "pplLinter.debounceMs": {
          "type": "integer",
          "description": "Debounce delay in milliseconds for linting on document modification."
        }
      }
    }
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.2.6",
    "smol-toml": "^1.9.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@testcontainers/opensearch": "^12.2.0",
    "@types/node": "^22.20.2",
    "@types/vscode": "^1.137.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "testcontainers": "^12.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
